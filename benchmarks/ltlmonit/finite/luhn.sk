pragma options "--bnd-unroll-amnt 11 --bnd-int-range 99 --bnd-arr-size 11";

generator int exp(int a,int bnd){
	assert(bnd >= 0);
	int t = ??;
	if(t == 0){return ??;}
	if(t == 1){return a;}
	
	if(t == 2){return exp(a,bnd-1)*exp(a,bnd-1);}
	if(t == 3){return exp(a,bnd-1)-exp(a,bnd-1);}
	if(t == 4){return exp(a,bnd-1)+exp(a,bnd-1);}
}

generator bit guard(int a){
	return {| (a | ??) (> | < | >= | <= | != | ==) (a | ??) |};
}

bit luhn([int n],int[n] cardNo){
	int sum = 0;
        bit pos = 0;
        int i = n-1;
        int d = cardNo[i];
	assert(G(sum-pre_sum >= 0 && sum-pre_sum <= 9));
        while(i >= 0){
                d = cardNo[i];
                if(pos){
                        d = d*??;
			if(cardNo[i] > ??){
				sum = sum+exp(d,1);		
			}else{
				sum = sum+exp(d,1);
			}
                }else{
			sum = sum+exp(d,1);
		}		
                pos = !pos;
                i = i-1;
        }
        return(sum%10 == 0);
}

harness void ex1(){
    assert(luhn({9, 5, 7, 6, 3, 5, 7, 2, 2, 0, 3}));
}
harness void ex2(){
    assert(luhn({0, 0, 0, 5, 5, 1, 1, 3, 0, 3, 9}));
}
