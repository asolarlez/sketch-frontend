pragma options "--bnd-arr-size 20 --bnd-unroll-amnt 20";

bit isSumm([int n],int[n] arr1,int[n] arr2,int[n] res){
	for(int i = 0;i < n;i++){
		if(res[i] != arr1[i]+arr2[i]){
			return 0;
		}
	}
	return 1;
}

void sumV([int n],int[n] arr1,int[n] arr2){
	int[n] res;
	int i = 0;
	int j = n-1;
	assert(G((0 <= i && i < n && 0 <= j && j < n) || (i > j)));
	while(i <= j){
		res[i] = arr1[{| i | j |}]+arr2[{| i | j |}];
		res[j] = arr1[{| i | j |}]+arr2[{| i | j |}];
		i = {| i+?? | i-?? | j+?? | j-?? |};
		j = {| i+?? | i-?? | j+?? | j-?? |};
	}
	assert(isSumm(arr1,arr2,res));
}

harness void main(int n,int[n] arr1,int[n] arr2){
	assume(n >= 1 && n <= 20);
	sumV(arr1,arr2);
}
